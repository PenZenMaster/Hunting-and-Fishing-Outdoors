# WordPress Core Files
# Ignore everything in the root except specific directories
/*
!.gitignore
!README.md
!CHANGELOG.md
!PROJECT-SETUP.md
!WORDPRESS-STANDARDS.md
!.claude-wordpress.md
!composer.json
!composer.lock
!package.json
!package-lock.json
!phpcs.xml.dist
!phpunit.xml.dist
!.phpunit.result.cache
!tests/

# Track wp-content (but exclude default themes/plugins)
!wp-content/

# wp-content exclusions
wp-content/index.php
wp-content/mu-plugins/index.php
wp-content/plugins/index.php
wp-content/themes/index.php

# Uploads directory (both standard and year-based structures)
wp-content/uploads/
wp-content/[0-9][0-9][0-9][0-9]/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/cache/
wp-content/backups/
wp-content/ai1wm-backups/
wp-content/updraft/

# WordPress cache files
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/*-cache*.php

# Backup and archive files in wp-content
wp-content/*.zip
wp-content/*.tar
wp-content/*.tar.gz
wp-content/*.sql
wp-content/*.sql.gz

# WordPress temporary files
wp-content/temp-write-test-*
wp-content/*.log

# Default WordPress Themes (exclude stock themes)
wp-content/themes/twenty*/

# Custom Themes - Track these themes
!wp-content/themes/wprentals/
!wp-content/themes/wprentals-child/

# Exclude theme zip files and demo data
wp-content/themes/*.zip
wp-content/themes/**/libs/plugins/*.zip
wp-content/themes/**/wpestate_templates/**/*.zip

# Exclude Redux Framework files from themes
wp-content/themes/**/admin/redux-extensions/

# Plugins - Exclude all by default, then include custom ones
wp-content/plugins/*
!wp-content/plugins/
!wp-content/plugins/wprentals-core/
!wp-content/plugins/wprentals-elementor/

# Exclude plugin zip files
wp-content/plugins/*.zip

# Exclude Redux Framework files from plugins
wp-content/plugins/**/admin/redux-extensions/
wp-content/plugins/**/admin/redux-framework/

# WordPress Plugin & Theme Editor Autosave
*.tmp

# Log files
*.log
error_log
debug.log

# Environment & Configuration
.env
.env.local
.env.*.local
wp-config.php
wp-config-local.php
local-xdebuginfo.php
.htaccess

# Database
*.sql
*.sql.gz

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/
.buildpath

# Node.js
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# Composer
/vendor/

# Build files
/dist/
/build/

# Testing
/tests/coverage/
.phpunit.result.cache

# Temporary files
*.bak
*.old
*.orig
*.tmp
